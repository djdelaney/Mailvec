{
  "version": 1,
  "provider": "gmail",
  "source": "hand-written",
  "description": "mark_read on a label-mode account: the open question in docs/proposals/read-state.md. Hand-written from Gmail's documented IMAP behaviour, not recorded: replace with a recording from the test account (docs/contributing/provider-traces.md).",
  "steps": [
    {
      "id": "arrives-unread",
      "serverAction": "m1 arrives unread: a copy in INBOX and one in All Mail.",
      "maildir": {
        "INBOX/new/1767603600.1001_1.mvtrace,U=11:2,": "m1.eml",
        "[Gmail]/All Mail/new/1767603600.1001_2.mvtrace,U=501:2,": "m1.eml",
        "[Gmail]/All Mail/cur/1767100000.900_1.mvtrace,U=500:2,S": "m2.eml"
      },
      "server": {
        "m1-receipt@trace.example": {
          "mailboxes": [
            "INBOX",
            "[Gmail]/All Mail"
          ],
          "seen": false
        },
        "m2-newsletter@trace.example": {
          "mailboxes": [
            "[Gmail]/All Mail"
          ],
          "seen": true
        }
      }
    },
    {
      "id": "marked-read-by-mailvec",
      "settled": false,
      "serverAction": "mark_read on m1. The sidecar renames the INBOX copy into cur/ with S, and mbsync (PushFlags) pushes \\Seen. Until mbsync pulls the flag onto the All Mail copy, one copy is unseen and Mailvec reports m1 unread.",
      "maildir": {
        "INBOX/cur/1767603600.1001_1.mvtrace,U=11:2,S": "m1.eml",
        "[Gmail]/All Mail/new/1767603600.1001_2.mvtrace,U=501:2,": "m1.eml",
        "[Gmail]/All Mail/cur/1767100000.900_1.mvtrace,U=500:2,S": "m2.eml"
      }
    },
    {
      "id": "flag-pulled",
      "serverAction": "mbsync pulls \\Seen onto the All Mail copy, moving it into cur/ (observed in the recorded label-lifecycle). Every copy is seen; m1 reads as read.",
      "maildir": {
        "INBOX/cur/1767603600.1001_1.mvtrace,U=11:2,S": "m1.eml",
        "[Gmail]/All Mail/cur/1767603600.1001_2.mvtrace,U=501:2,S": "m1.eml",
        "[Gmail]/All Mail/cur/1767100000.900_1.mvtrace,U=500:2,S": "m2.eml"
      },
      "server": {
        "m1-receipt@trace.example": {
          "mailboxes": [
            "INBOX",
            "[Gmail]/All Mail"
          ],
          "seen": true
        },
        "m2-newsletter@trace.example": {
          "mailboxes": [
            "[Gmail]/All Mail"
          ],
          "seen": true
        }
      }
    }
  ]
}
