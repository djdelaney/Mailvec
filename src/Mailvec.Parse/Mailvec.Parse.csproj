<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The `parse` container: the one process that eats attacker-chosen bytes.
       A minimal Kestrel host exposing IMailParser over HTTP (the routes are in
       Mailvec.Parsing.Contracts.ParserWire). It references Mailvec.Parsing and
       NOTHING else of ours — no Mailvec.Core, so no SQLite, no shared-config
       loader, no options that know where secrets live. In compose it runs
       non-root with no volumes, no secrets and no egress; see
       docs/proposals/attachment-parser-isolation.md. -->

  <PropertyGroup>
    <RootNamespace>Mailvec.Parse</RootNamespace>
    <UserSecretsId></UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mailvec.Parsing\Mailvec.Parsing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mailvec.Parse.Tests" />
  </ItemGroup>

</Project>
