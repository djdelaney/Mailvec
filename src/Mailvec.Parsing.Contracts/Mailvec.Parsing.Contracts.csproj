<Project Sdk="Microsoft.NET.Sdk">

  <!-- The seam between the processes that hold the mailbox and the code that
       parses attacker-chosen bytes: IMailParser plus the plain-data records that
       cross it. NO package references and NO project references, on purpose —
       Mailvec.Core references this so it can talk to a parser without linking
       one, and Mailvec.Parsing references it so the parser can be built without
       Core (no SQLite, no config loader, no options that know where secrets
       live). See docs/proposals/attachment-parser-isolation.md.

       Types moved here from Core keep their original namespaces
       (Mailvec.Core.Parsing / .Attachments / .Models) so the move is a
       project-boundary change, not a rename. -->

  <PropertyGroup>
    <RootNamespace>Mailvec.Parsing.Contracts</RootNamespace>
  </PropertyGroup>

</Project>
