# Copy to .env next to compose.yml and fill in. Everything here is
# deployment-specific; the container-shaped path defaults live in the
# Dockerfile and compose.yml.

# The external Ollama instance — set this to its LAN address, e.g.
# http://192.168.1.50:11434, and >= the Ollama floor in ops/UPGRADING.md.
#
# ALWAYS REQUIRED. This is the EMBEDDING model (mxbai-embed-large): the embedder
# needs it for chunk vectors and the MCP server for query vectors. It is NOT
# optional when OCR is switched to a hosted provider — MAILVEC_VISION_PROVIDER
# below replaces the VISION model only.
#
# Leaving it blank does not disable Ollama. Compose falls back to
# http://localhost:11434, which inside a container is that container, so every
# embedding call fails with "Connection refused" and indexing stops. (The
# services now log one clear warning about this at startup, but the fix is here.)
#
# Models to pull: mxbai-embed-large always; the vision model (qwen2.5vl:7b) ONLY
# when MAILVEC_VISION_PROVIDER is unset or `ollama`. A hosted OCR provider needs
# no vision model pulled at all — useful when the GPU is unavailable, since the
# embedding model is small enough to run on CPU.
OLLAMA_BASE_URL=

# --- OCR tuning for the Ollama host's actual speed --------------------------
# All four are unset-safe: leaving them empty reproduces the in-binary defaults
# (true / true / 120 / 2048). They exist because the vision pass is the one
# workload whose cost swings by an order of magnitude with the Ollama host's
# hardware, and the shipped defaults assume a GPU.
#
# Measure before choosing. Time one real page against the host:
#   curl -s -X POST $OLLAMA_BASE_URL/api/generate -d @payload.json \
#     | jq '{prompt_eval_count, prompt_eval_duration, eval_count, eval_duration}'
# Durations are nanoseconds. What matters is that the TOTAL comfortably fits
# MAILVEC_VISION_TIMEOUT_SECONDS, because the vision HttpClient has no
# resilience handler — that timeout is the entire budget for a call.
#
# Observed 2026-08-06 on a CPU-only host (16 threads, GPU failed), qwen2.5vl:7b
# via a 1536px page render — treat as a worked example, not as current state:
#   real page   410s  (377s prompt eval + 32s generation)
#   health probe 168s (the 48x48 blank image AttachmentOcrService OCRs to tell
#                     a poison document from a wedged Ollama — NOT cheap: the
#                     model upsamples to a minimum pixel budget, so a tiny
#                     probe costs about what a real page costs)
# Against the 120s default every vision call timed out, including the probe.
# That is the safe failure: with the probe failing too, SettleVisionFailures
# counts nothing toward retirement and nothing is stamped 'failed'. The cost is
# an OCR pass that burns ~20 min of CPU per cycle producing nothing, while
# contending with the embed pass (measured: 1.1s -> 6.3s per chunk).
#
# On a slow host, prefer switching OCR off over letting it grind: the backlog
# stays at 'no_text'/'unsupported' and the embedder re-picks it up when these
# go back to true — no reindex, nothing lost.
#MAILVEC_OCR_ENABLED=false
#MAILVEC_IMAGE_OCR_ENABLED=false
#
# If you would rather it keep crawling, raise the ceiling instead. 900 gives
# ~2.2x headroom over the 410s above, and 1024 output tokens bounds a
# repetition loop at ~180s of generation so the worst case (~560s) still fits.
# Above ~1024 the two interact badly: 2048 tokens at CPU speed is 360s of
# generation ALONE, which alone nearly fills the 900s. Also drop OcrBatchSize
# and OcrMaxPagesPerPdf if you go this way — at 7 min/page the shipped 4 and 20
# mean a single cycle can starve the embed pass for hours.
#MAILVEC_VISION_TIMEOUT_SECONDS=900
#MAILVEC_VISION_MAX_TOKENS=1024

# Minimum characters an OCR result must contain to be stored as text (default
# 10). Below the floor the attachment is recorded as having no text instead.
#
# Vision models return a stray glyph or two off photographs of physical
# objects, and without a floor that becomes indexed, searchable content on a
# document nothing will revisit — the status is terminal either way. Observed:
# a 2.8 MB phone photo of children's placemats stored as "1.1", while its
# near-identical sibling photo correctly came back empty.
#
# The right value is a judgement about your mail. Raise it if junk still gets
# through; lower it if genuinely short results you wanted — a door number, a
# receipt total — are being discarded. 0 stores whatever comes back.
#
# Only affects OCR runs AFTER it is set: previously-stored results keep their
# text until re-run through `mailvec reocr`.
#MAILVEC_OCR_MIN_TEXT_CHARS=10

# ---------------------------------------------------------------------------
# Vision provider for the OCR passes: `ollama` (default) or `mistral`.
#
# `ollama` runs the local vision model on the GPU box — nothing leaves the LAN,
# which is why it is the default: scanned attachments are routinely bank
# statements, tax forms and medical letters, and the OCR pass feeds them
# UNATTENDED (no tool call, no user in the loop).
#
# `mistral` sends every rendered page to the hosted mistral-ocr API instead.
# Roughly 5-8x faster and comparable quality (docs/contributing/ocr-bakeoff-2026-08-06.md),
# and the option to reach for when the GPU is unavailable — but it is a real
# change to the threat model, not a tuning knob. Read docs/security.md first.
#
# OLLAMA_BASE_URL is still required with this set — see above. This replaces the
# vision model, not the embedding model.
#
# The provider name, endpoint and model reach EVERY service, so `mailvec doctor`
# and /health always name the engine actually in use. The API KEY reaches only
# the embedder, where OCR runs — so the internet-fronted mcp container never
# holds it, and reports the provider as "configured, not checkable from this
# process" rather than pretending to have verified it.
#
# Endpoint/Model for Azure AI Foundry: the resource URL and the DEPLOYMENT name
# (not a public model id). The route below is the Foundry one; api.mistral.ai
# uses `v1/ocr` instead. Observed 2026-08-06 — verify rather than trust.
#
# Container env is fixed at creation: use `up -d embedder`, not `restart`.
#
# Switching providers does NOT re-OCR anything already decided — run
# `mailvec reocr` (dry run by default) to re-queue the old engine's verdicts.
#MAILVEC_VISION_PROVIDER=mistral
#MAILVEC_MISTRAL_ENDPOINT=https://<resource>.services.ai.azure.com
#MAILVEC_MISTRAL_MODEL=<deployment-name>
#MAILVEC_MISTRAL_ROUTE=providers/mistral/azure/ocr
#
# API key. Keep it HERE, in this gitignored .env — never in the shared
# appsettings.Local.json, which is world-readable (0644) and holds ordinary
# user settings.
#MAILVEC_MISTRAL_API_KEY=

# cloudflared tunnel token (Cloudflare Zero Trust dashboard -> Tunnels).
# Point the tunnel's ingress at http://mcp:3333.
TUNNEL_TOKEN=

# Optional: edge transport for the tunnel. auto | http2 | quic; compose
# defaults to `auto` (cloudflared's own default: QUIC, falling back to http2 if
# UDP won't connect). Leave unset unless your network is UDP-hostile — the
# symptom is repeated "connIndex 3" reconnect flapping in the cloudflared log,
# and `auto` will NOT self-correct it, because its fallback is decided at
# connect time and this failure appears after a healthy connect. Set http2
# there. Per-network workaround, not a general recommendation.
#TUNNEL_TRANSPORT_PROTOCOL=http2

# The public hostname the tunnel serves (e.g. mailvec.example.com). Required
# for tunnel traffic: the MCP server's DNS-rebinding HostGuard rejects any
# request whose Host header isn't loopback or allowlisted, and cloudflared
# forwards the original public Host. Leave empty until the tunnel goes live.
MCP_PUBLIC_HOSTNAME=

# The address LAN clients use to reach the MCP server directly (the Docker
# VM's IP or LAN hostname, e.g. 192.168.1.50) — needed for pre-tunnel testing
# or persistent on-network access, together with uncommenting the mcp
# service's ports: mapping in compose.yml. Same HostGuard rule as above.
MCP_LAN_HOSTNAME=

# --- Origin validation of the Cloudflare Access assertion -------------------
# Second layer behind the tunnel: with these set, the MCP server itself refuses
# any request that doesn't carry a valid Cf-Access-Jwt-Assertion, instead of
# trusting everything that can reach mcp:3333. Leave EMPTY and the server
# behaves exactly as before (Access remains the sole gate) — it just logs a
# warning at boot saying so.
#
# Turning it on is a two-value change and a verify step; see
# docs/remote-access-cloudflare.md "Origin validation". Get both values from
# the Zero Trust dashboard:
#   TEAM_DOMAIN  Settings -> Custom Pages / team domain, as a full https URL.
#   AUDIENCE     Access -> Applications -> <the Mailvec app> -> Overview ->
#                "Application Audience (AUD) Tag".
# Setting MCP_ACCESS_ENABLED=true without both of the others makes the server
# refuse to start, naming the missing one — deliberately, so a half
# configuration can't look protected while admitting every app in the account.
# Must be the literal `true` or `false` (not 1/0) — .NET's config binder only
# understands those, and an unbindable value silently reads as false.
MCP_ACCESS_ENABLED=
MCP_ACCESS_TEAM_DOMAIN=
MCP_ACCESS_AUDIENCE=

# The AUD tag of the SEPARATE, path-scoped Access application that fronts /up
# for the external monitor. Optional, and worth setting if you have one: it is
# what stops a leaked monitoring credential from reading mail, at the origin,
# rather than relying on the Cloudflare-side path scoping being right. Tokens
# carrying it reach /up and nothing else. Must differ from MCP_ACCESS_AUDIENCE
# (the same value would silently grant the monitor the whole mailbox — the
# server refuses to start on that).
MCP_ACCESS_MONITORING_AUDIENCE=

# Exempt loopback callers from the assertion check. Leave unset (= true). The
# compose healthcheck and `mailvec doctor` reach /health over 127.0.0.1 with no
# assertion to present, so setting this false marks the container permanently
# unhealthy. Overridable only because everything else here is; there is no good
# reason to change it in a container.
#MCP_ACCESS_ALLOW_LOOPBACK=true

# Serve /health only to loopback callers; everyone else gets 404. Leave unset
# (= true). /health discloses the archive path, corpus counts, the embedding
# model identity and the internal Ollama LAN address — /up exists precisely so
# no external caller needs any of it, and Uptime Kuma polls /up. Every real
# /health consumer is already loopback (the compose healthcheck and `mailvec
# doctor` under `docker compose exec`).
# Set false only if something genuinely off-box needs the detailed body.
#MCP_RESTRICT_HEALTH_TO_LOOPBACK=true

# Optional: Fastmail account id (the u<hex> query param in webmail URLs).
# Empty = search results omit webmailUrl links.
FASTMAIL_ACCOUNT_ID=

# Sync cadence for the mbsync sidecar: how long the loop sleeps AFTER a sync
# finishes, not an independent timer. The loop runs `mbsync -a`, waits for that
# exact child, then sleeps — so it cannot overlap its own runs and a backlog
# pull never queues anything behind it.
#
# 600s is therefore a load choice against your IMAP provider, NOT a safety
# floor. This comment used to point at the launchd plist's .mbsyncstate lock
# rationale as a reason not to lower it; that rationale describes launchd's
# StartInterval, not this loop. Lowering it is a supportable change — see
# docs/future-ideas.md's one-minute polling plan for the canary that would
# justify it, and note the heartbeat is independent of this value (it beats on
# its own 60s timer), so shortening this does not risk a false "mbsync is dead".
MBSYNC_INTERVAL_SECONDS=600

# 1 = services refuse to start if ./data/archive.sqlite is missing or empty
# (protects a snapshot-seeded deployment from silently serving a fresh empty
# archive after a bad volume mount). Set to 0 only for a deliberate
# from-scratch rebuild.
MAILVEC_REQUIRE_SEEDED_DB=1

# Deploy from prebuilt GHCR images instead of building on this host.
# Leave both unset to build locally (the default). To pull: set BOTH to a
# PINNED tag (sha-<gitsha> or v<version> — don't chase :latest; updates are
# manual + backup-first because SchemaMigrator runs against the seeded
# archive on every start), then `docker compose pull && docker compose up -d`.
# Never run `--build` while these point at the GHCR refs (it would retag the
# remote name with a local build). Private packages need a one-time
# `docker login ghcr.io` on this host (PAT with read:packages) — do that
# from the host CLI even if a UI like Dockge drives the pulls.
#MAILVEC_IMAGE=ghcr.io/djdelaney/mailvec:sha-xxxxxxx
#MAILVEC_MBSYNC_IMAGE=ghcr.io/djdelaney/mailvec-mbsync:sha-xxxxxxx
