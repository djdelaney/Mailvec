# Copy to .env next to compose.yml and fill in. Everything here is
# deployment-specific; the container-shaped path defaults live in the
# Dockerfile and compose.yml.

# The external Ollama instance (GPU VM) — set this to its LAN address, e.g.
# http://192.168.1.50:11434. Must have the embedding model and — if OCR is
# enabled — the vision model pulled, and be >= the Ollama floor in
# ops/UPGRADING.md.
OLLAMA_BASE_URL=

# cloudflared tunnel token (Cloudflare Zero Trust dashboard -> Tunnels).
# Point the tunnel's ingress at http://mcp:3333.
TUNNEL_TOKEN=

# Optional: edge transport for the tunnel. auto | http2 | quic; compose
# defaults to `auto` (cloudflared's own default: QUIC, falling back to http2 if
# UDP won't connect). Leave unset unless your network is UDP-hostile — the
# symptom is repeated "connIndex 3" reconnect flapping in the cloudflared log,
# and `auto` will NOT self-correct it, because its fallback is decided at
# connect time and this failure appears after a healthy connect. Set http2
# there. Per-network workaround, not a general recommendation.
#TUNNEL_TRANSPORT_PROTOCOL=http2

# The public hostname the tunnel serves (e.g. mailvec.example.com). Required
# for tunnel traffic: the MCP server's DNS-rebinding HostGuard rejects any
# request whose Host header isn't loopback or allowlisted, and cloudflared
# forwards the original public Host. Leave empty until the tunnel goes live.
MCP_PUBLIC_HOSTNAME=

# The address LAN clients use to reach the MCP server directly (the Docker
# VM's IP or LAN hostname, e.g. 192.168.1.50) — needed for pre-tunnel testing
# or persistent on-network access, together with uncommenting the mcp
# service's ports: mapping in compose.yml. Same HostGuard rule as above.
MCP_LAN_HOSTNAME=

# --- Origin validation of the Cloudflare Access assertion -------------------
# Second layer behind the tunnel: with these set, the MCP server itself refuses
# any request that doesn't carry a valid Cf-Access-Jwt-Assertion, instead of
# trusting everything that can reach mcp:3333. Leave EMPTY and the server
# behaves exactly as before (Access remains the sole gate) — it just logs a
# warning at boot saying so.
#
# Turning it on is a two-value change and a verify step; see
# docs/remote-access-cloudflare.md "Origin validation". Get both values from
# the Zero Trust dashboard:
#   TEAM_DOMAIN  Settings -> Custom Pages / team domain, as a full https URL.
#   AUDIENCE     Access -> Applications -> <the Mailvec app> -> Overview ->
#                "Application Audience (AUD) Tag".
# Setting MCP_ACCESS_ENABLED=true without both of the others makes the server
# refuse to start, naming the missing one — deliberately, so a half
# configuration can't look protected while admitting every app in the account.
# Must be the literal `true` or `false` (not 1/0) — .NET's config binder only
# understands those, and an unbindable value silently reads as false.
MCP_ACCESS_ENABLED=
MCP_ACCESS_TEAM_DOMAIN=
MCP_ACCESS_AUDIENCE=

# The AUD tag of the SEPARATE, path-scoped Access application that fronts /up
# for the external monitor. Optional, and worth setting if you have one: it is
# what stops a leaked monitoring credential from reading mail, at the origin,
# rather than relying on the Cloudflare-side path scoping being right. Tokens
# carrying it reach /up and nothing else. Must differ from MCP_ACCESS_AUDIENCE
# (the same value would silently grant the monitor the whole mailbox — the
# server refuses to start on that).
MCP_ACCESS_MONITORING_AUDIENCE=

# Exempt loopback callers from the assertion check. Leave unset (= true). The
# compose healthcheck and `mailvec doctor` reach /health over 127.0.0.1 with no
# assertion to present, so setting this false marks the container permanently
# unhealthy. Overridable only because everything else here is; there is no good
# reason to change it in a container.
#MCP_ACCESS_ALLOW_LOOPBACK=true

# Serve /health only to loopback callers; everyone else gets 404. Leave unset
# (= true). /health discloses the archive path, corpus counts, the embedding
# model identity and the internal Ollama LAN address — /up exists precisely so
# no external caller needs any of it, and Uptime Kuma polls /up. Every real
# /health consumer is already loopback (the compose healthcheck, `mailvec
# doctor` under `docker compose exec`, the tray on local installs).
# Set false only if something genuinely off-box needs the detailed body.
#MCP_RESTRICT_HEALTH_TO_LOOPBACK=true

# Optional: Fastmail account id (the u<hex> query param in webmail URLs).
# Empty = search results omit webmailUrl links.
FASTMAIL_ACCOUNT_ID=

# Sync cadence for the mbsync sidecar. 600s matches the old launchd job; see
# the plist comment about .mbsyncstate lock contention before lowering it.
MBSYNC_INTERVAL_SECONDS=600

# 1 = services refuse to start if ./data/archive.sqlite is missing or empty
# (protects a snapshot-seeded deployment from silently serving a fresh empty
# archive after a bad volume mount). Set to 0 only for a deliberate
# from-scratch rebuild.
MAILVEC_REQUIRE_SEEDED_DB=1

# Deploy from prebuilt GHCR images instead of building on this host.
# Leave both unset to build locally (the default). To pull: set BOTH to a
# PINNED tag (sha-<gitsha> or v<version> — don't chase :latest; updates are
# manual + backup-first because SchemaMigrator runs against the seeded
# archive on every start), then `docker compose pull && docker compose up -d`.
# Never run `--build` while these point at the GHCR refs (it would retag the
# remote name with a local build). Private packages need a one-time
# `docker login ghcr.io` on this host (PAT with read:packages) — do that
# from the host CLI even if a UI like Dockge drives the pulls.
#MAILVEC_IMAGE=ghcr.io/djdelaney/mailvec:sha-xxxxxxx
#MAILVEC_MBSYNC_IMAGE=ghcr.io/djdelaney/mailvec-mbsync:sha-xxxxxxx
