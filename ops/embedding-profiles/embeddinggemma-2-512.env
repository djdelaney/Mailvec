# embeddinggemma-2 truncated 768 -> 512 (Matryoshka). Half mxbai's vector
# width, so every semantic query scans half the bytes. Google's model card
# puts the cost at MTEB multilingual 61.36 -> 61.17; on the subset corpus,
# cutting mxbai 1024 -> 512 cost nothing (2026-10-07). Compare against the
# same baseline as the 768 run so the two are directly comparable.
#
# Prefixes and tag notes: see embeddinggemma-2-768.env.
#
#   ollama pull embeddinggemma-2:270m
Embedding__ActiveProfile=experiment
Embedding__Profiles__experiment__Protocol=ollama
Embedding__Profiles__experiment__Request__Model=embeddinggemma-2:270m
Embedding__Profiles__experiment__OutputDimensions=512
Embedding__Profiles__experiment__NativeDimensions=768
Embedding__Profiles__experiment__Text__QueryPrefix='task: search result | query: '
Embedding__Profiles__experiment__Text__DocumentPrefix='title: none | text: '
