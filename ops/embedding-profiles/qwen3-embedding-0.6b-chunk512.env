# qwen3-embedding:0.6b with 512-token chunks instead of 200 — the "chunk
# size as a second knob" follow-up from 2026-06-12, never run. 200 was sized
# for mxbai's 512-token context; qwen3 reads 32K.
#
# Compare against a qwen3-embedding-0.6b.env run, NOT the default baseline,
# so the chunk size is the only variable:
#   ops/embedding-experiment.sh --name qwen06b-c512 --profile ops/embedding-profiles/qwen3-embedding-0.6b-chunk512.env \
#       --source <archive> --baseline "<experiments dir>/qwen06b/report.json"
Embedding__ActiveProfile=experiment
Embedding__Profiles__experiment__Protocol=ollama
Embedding__Profiles__experiment__Request__Model=qwen3-embedding:0.6b
Embedding__Profiles__experiment__OutputDimensions=1024
Embedding__Profiles__experiment__Text__QueryPrefix=$'Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery: '
Embedder__ChunkSizeTokens=512
Embedder__ChunkOverlapTokens=64
