# qwen3-embedding:4b truncated 2560 -> 1024 (Matryoshka). The 4b was the
# only model to beat mxbai on both legs (2026-06-12: semantic 0.887, hybrid
# 0.949) but at 2560d the vec0 scan made hybrid search take 21.5 s. At 1024d
# the scan is mxbai-sized again; the question is how much quality survives.
# Temper expectations: Fireworks qwen3-8b @1024 (2026-08-08) improved
# semantic but regressed hybrid.
#
#   ollama pull qwen3-embedding:4b
Embedding__ActiveProfile=experiment
Embedding__Profiles__experiment__Protocol=ollama
Embedding__Profiles__experiment__Request__Model=qwen3-embedding:4b
Embedding__Profiles__experiment__OutputDimensions=1024
Embedding__Profiles__experiment__NativeDimensions=2560
Embedding__Profiles__experiment__Text__QueryPrefix=$'Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery: '
