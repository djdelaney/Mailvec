# qwen3-embedding:0.6b @1024 — the 2026-06-11 candidate that tied mxbai
# (semantic 0.865 vs 0.843, hybrid 0.935 vs 0.944 on the full archive).
# Instruction-tuned: the query prefix is load-bearing (+0.32 semantic NDCG
# in that run); documents stay bare.
#
#   ollama pull qwen3-embedding:0.6b
#   ops/embedding-experiment.sh --name qwen06b --profile ops/embedding-profiles/qwen3-embedding-0.6b.env --source <archive>
Embedding__ActiveProfile=experiment
Embedding__Profiles__experiment__Protocol=ollama
Embedding__Profiles__experiment__Request__Model=qwen3-embedding:0.6b
Embedding__Profiles__experiment__OutputDimensions=1024
Embedding__Profiles__experiment__Text__QueryPrefix=$'Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery: '
