## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/
coverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Mailvec
appsettings.Local.json
*.sqlite
*.sqlite-wal
*.sqlite-shm
/Mail/
# sqlite-vec natives fetched by ops/fetch-sqlite-vec.sh (any RID)
runtimes/*/native/
/dist/
# Stray build output (the tray's xcodebuild archive used to land here).
/build/
*.mcpb
.DS_Store

# Docker compose deployment-local state (bind mounts, config, secrets —
# these live on the Docker host next to compose.yml, never in git)
/data/
/mail/
/secrets/
/mbsyncrc

# Claude Code local state
.claude/worktrees/
.claude/settings.local.json
logs/

# Ad-hoc review write-ups dropped in the repo root during a working session.
# Kept on disk, out of history: they are point-in-time findings about a specific
# commit range, not documentation. Anything worth keeping gets filed under
# docs/contributing/ with a dated name (see ocr-bakeoff-2026-08-06.md) rather
# than left loose here — and ignoring them stops a stray `git add -A` sweeping
# them in, which is exactly how two of them got committed.
/*REVIEW*.md
