<Project Sdk="Microsoft.NET.Sdk">

  <!-- OCR bake-off harness: measures transcription quality, latency and cost of
       one OCR engine against another over real documents from the archive.
       A development tool, NOT part of the shipped product — nothing in src/
       references it and ops/install.sh never publishes it. See README.md. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Mailvec.OcrBench</RootNamespace>
    <AssemblyName>ocrbench</AssemblyName>
    <!-- Never packed or published with the services. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mailvec.Core\Mailvec.Core.csproj" />
    <ProjectReference Include="..\..\src\Mailvec.Pdf\Mailvec.Pdf.csproj" />
  </ItemGroup>

</Project>
